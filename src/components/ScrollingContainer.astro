---
const { cardContent } = Astro.props;
---

<ul class="full-width">
  {
    cardContent.map((card) => (
      <li>
        <h3>{card.title}</h3>
        <p>{card.body}</p>
      </li>
    ))
  }
</ul>

<style>
  ul {
    list-style: none;
    display: flex;
    gap: var(--card-gap);
    overflow-x: auto;
    width: 100%;
    margin: 0 auto;
    padding: 0 0 1rem 0;
    padding-inline: max(1rem, 50% - var(--content-width) / 2);
  }

  li {
    background-color: var(--card-background);
    color: var(--card-text-color);
    padding: var(--card-padding);
    border-radius: var(--card-border-radius);
    flex-basis: 30rem;
    flex-shrink: 0;
  }
</style>
